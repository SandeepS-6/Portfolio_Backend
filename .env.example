DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/portfolio
PORT=5000
NODE_ENV=development
URL=http://localhost
SITE_URL=http://localhost:5173

FRONTEND_URL=http://localhost:5173
CMS_URL=http://localhost:5174
API_PUBLIC_URL=http://localhost:5000

JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
REFRESH_COOKIE_NAME=portfolio_refresh
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMeNow!123

# OAuth (CMS sign-in). Callback URLs must match exactly:
#   {API_PUBLIC_URL}/api/auth/oauth/google/callback
#   {API_PUBLIC_URL}/api/auth/oauth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Unique Meet links per booking (Calendar API). Run: npm run google:calendar-token
GOOGLE_REFRESH_TOKEN=
# Fallback Meet room if Calendar create fails
GOOGLE_MEET_URL=

# Password-reset + meeting emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=
MAIL_FROM=
